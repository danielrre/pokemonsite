---
import MainLayout from '../../layouts/MainLayout.astro';
import RymCard from '../../components/RymCard.astro';

const title = 'My Rick and Morty Site';

const response = await fetch("https://rickandmortyapi.com/api/character");
const data: { results: { name: string, image: string }[] } = await response.json();


const { name }   = Astro.params;
const { imageSrc } = Astro.props;
---

<MainLayout title={title}>
  <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 mt-4">
        {data.results.map((character) => (
            <RymCard name={character.name} imageSrc={character.image} />
        ))}
  </section>
  <a href="/" class="text-2xl text-center block mt-4">Back</a>
</MainLayout>

<style>
    @reference "tailwindcss";
    a {
        @apply hover:underline text-blue-500;
    } 
</style>